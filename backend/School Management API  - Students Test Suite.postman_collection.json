	"item": [
		{
			"name": "AUTH",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login returns 200\", () => pm.response.to.have.status(200));",
									"",
									"// Try to extract CSRF from cookies",
									"let csrf = pm.cookies.get('csrfToken');",
									"",
									"if (!csrf) {",
									"  console.log('Cookie not visible. Checking Set-Cookie header…');",
									"  const setCookieHeader = pm.response.headers.get('Set-Cookie');",
									"  if (setCookieHeader) {",
									"      const match = setCookieHeader.match(/csrfToken=([^;]+)/);",
									"      if (match) csrf = match[1];",
									"  }",
									"}",
									"",
									"if (csrf) {",
									"   pm.environment.set('csrfToken', csrf);",
									"   console.log('CSRF saved →', csrf);",
									"} else {",
									"   console.log('No CSRF token found');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-csrf-token",
								"value": "{{csrfToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin@school-admin.com\",\n  \"password\": \"3OU4zn3q6Zh9\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
